# =============================================================
# EDXSO AI Influencer Outreach System - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- YouTube Data API v3 ---
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Google Gemini API ---
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email Sending (Optional) ---
# For Gmail: enable "App Passwords" at https://myaccount.google.com/apppasswords
# Requires 2FA to be enabled on your Google account
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Configuration ---
# Target niche for influencer discovery
TARGET_NICHE=Technology/AI
# Minimum followers for micro-influencer classification
MIN_FOLLOWERS=5000
# Maximum followers for micro-influencer classification
MAX_FOLLOWERS=100000
# Minimum engagement rate (as percentage)
MIN_ENGAGEMENT_RATE=2.0
# Number of influencers to discover
DISCOVERY_TARGET=50
